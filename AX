                    bill.Size = UDim2.new(0, 120, 0, 35)
                    bill.AlwaysOnTop = true
                    
                    local txt = bill:FindFirstChildOfClass("TextLabel") or Instance.new("TextLabel", bill)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Color3.fromRGB(255, 215, 0)
                    txt.TextStrokeTransparency = 0
                    txt.TextSize = 11
                    txt.Font = Enum.Font.GothamBold
                    
                    local tenVn = "Vật Phẩm"
                    local lname = obj.Name:lower()
                    if lname:find("fruit") then tenVn = "Trái Ác Quỷ"
                    elseif lname:find("chest") then tenVn = "Rương Báu"
                    elseif lname:find("sword") then tenVn = "Thanh Kiếm" end
                    
                    local dist = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and math.floor((LocalPlayer.Character.HumanoidRootPart.Position - obj.Position).Magnitude) or 0
                    txt.Text = tenVn .. "\n[" .. dist .. "m]"
                end
            end
        end)
    else
        if vnEspConn then vnEspConn:Disconnect() vnEspConn = nil end
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj:FindFirstChild("VNESP") then
                obj.VNESP:Destroy()
            end
        end
    end
end)

