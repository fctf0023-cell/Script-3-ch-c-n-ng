createCategory("GIẢ LẬP PC", 184)

local pcGui = Instance.new("ScreenGui", PlayerGui)
pcGui.Name = "AxiomPCController"
pcGui.Enabled = false

local function createKey(text, keyCode, pos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 42, 0, 42)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    btn.BorderColor3 = Color3.fromRGB(0, 255, 120)
    btn.TextColor3 = Color3.fromRGB(0, 255, 120)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.Parent = pcGui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    btn.MouseButton1Down:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    end)
    btn.MouseButton1Up:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        btn.TextColor3 = Color3.fromRGB(0, 255, 120)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

createKey("W", Enum.KeyCode.W, UDim2.new(0, 50, 1, -130))
createKey("A", Enum.KeyCode.A, UDim2.new(0, 5, 1, -85))
createKey("S", Enum.KeyCode.S, UDim2.new(0, 50, 1, -85))
