local vnEspConn
createButton("🏷️ Đồ Tên (Tiếng Việt & Khoảng Cách)", 316, function(state)
    if state then
        vnEspConn = RunService.Heartbeat:Connect(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name:lower():find("item") or obj.Name:lower():find("fruit") or obj:FindFirstChildOfClass("TouchTransmitter")) then
                    local bill = obj:FindFirstChild("VNESP") or Instance.new("BillboardGui", obj)
