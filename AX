-- Hàm tạo tiêu đề mục phân loại
local function createCategory(text, posY)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 300, 0, 25)
    lbl.Position = UDim2.new(0.5, -150, 0, posY)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(0, 255, 120)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = "📌 " .. text
    lbl.Parent = MainFrame
end

-- Hàm tạo nút bấm tính năng
local function createButton(text, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 300, 0, 32)
    btn.Position = UDim2.new(0.5, -150, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = text
    btn.Parent = MainFrame

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        else
            btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        end
        callback(active, btn)
    end)
end

